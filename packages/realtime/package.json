{
  "name": "@sentio/realtime",
  "version": "0.0.0",
  "private": true,
  "description": "Contrato de eventos Socket.IO y cliente tipado.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./events": {
      "types": "./dist/events.d.ts",
      "default": "./dist/events.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "socket.io-client": "4.8.4"
  },
  "devDependencies": {
    "@sentio/config": "workspace:*",
    "eslint": "9.39.5",
    "typescript": "5.9.3"
  }
}
