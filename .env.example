# Copia este archivo a .env (Copy-Item .env.example .env) y rellena los valores.
# .env está en .gitignore: nunca subas secretos al repositorio.

# --- General ---
NODE_ENV=development
APP_NAME=Sentio

# --- API (apps/api) ---
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
# Orígenes permitidos para CORS y Socket.IO, separados por comas.
CORS_ORIGINS=http://localhost:3000,http://localhost:8081
GRAPHQL_PLAYGROUND=true
GRAPHQL_DEPTH_LIMIT=7

# --- MongoDB ---
# Local (docker compose, replica set rs0):
MONGODB_URI=mongodb://localhost:27017/sentio?replicaSet=rs0
# Atlas (ejemplo): mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/sentio?retryWrites=true&w=majority

# --- Redis (BullMQ, rate limit, adaptador Socket.IO) ---
REDIS_URL=redis://localhost:6379

# --- Auth ---
# Genera cada secreto con:  node -e "console.log(require('crypto').randomBytes(64).toString('base64url'))"
JWT_ACCESS_SECRET=
# Se usa como pepper (HMAC) para guardar el hash de los refresh tokens opacos.
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
JWT_ISSUER=sentio-api
JWT_AUDIENCE=sentio-clients
# Cookie httpOnly del refresh token para la web.
REFRESH_COOKIE_NAME=sentio_rt
COOKIE_SECURE=false

# --- Rate limit ---
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_AUTH_MAX=10
# Publicaciones por usuario y hora.
RATE_LIMIT_POSTS_PER_HOUR=10
# Envíos de "compartir" por usuario y hora.
RATE_LIMIT_SHARES_PER_HOUR=30
# Búsquedas por usuario y minuto.
RATE_LIMIT_SEARCH_PER_MINUTE=30

# --- Privacidad (LFPDPPP) ---
# Versión vigente del Aviso de Privacidad que el usuario acepta al registrarse.
PRIVACY_NOTICE_VERSION=2026-11-03
PRIVACY_NOTICE_URL=http://localhost:3000/es/aviso-de-privacidad
# Correo del responsable para solicitudes de derechos ARCO.
ARCO_CONTACT_EMAIL=privacidad@example.com

# --- Media: fotos de perfil ---
# s3: MinIO local (pnpm infra:up) o S3 en producción.
# memory: en memoria de la API, sin Docker (se pierde al reiniciar; prohibido en producción).
STORAGE_DRIVER=s3
# Endpoint que usa la API para hablar con S3/MinIO (vacío = AWS S3).
S3_ENDPOINT=http://localhost:9000
# Host que se firma en las URLs de subida: debe ser alcanzable desde el cliente.
# En un dispositivo físico usa la IP LAN de tu PC, p. ej. http://192.168.1.50:9000
S3_PRESIGN_ENDPOINT=http://localhost:9000
# Base pública de lectura de las variantes (el prefijo avatars/ es de lectura anónima).
S3_PUBLIC_URL=http://localhost:9000/sentio-media
S3_REGION=us-east-1
S3_BUCKET=sentio-media
# En local son las credenciales raíz de MinIO (docker compose las usa al crear el contenedor).
S3_ACCESS_KEY_ID=sentio
S3_SECRET_ACCESS_KEY=sentio-dev-secret
S3_FORCE_PATH_STYLE=true

# --- Búsqueda ---
# local: MongoDB local (campos normalizados + índice de texto).
# atlas: Atlas Search; crea antes los índices de infra/atlas-search/ (ver su README).
SEARCH_PROVIDER=local
ATLAS_SEARCH_USERS_INDEX=users_search
ATLAS_SEARCH_POSTS_INDEX=posts_search

# --- Clientes ---
NEXT_PUBLIC_API_URL=http://localhost:4000/graphql
NEXT_PUBLIC_WS_URL=http://localhost:4000
# En un dispositivo físico usa la IP LAN de tu PC en lugar de localhost.
EXPO_PUBLIC_API_URL=http://localhost:4000/graphql
EXPO_PUBLIC_WS_URL=http://localhost:4000
# Base de los enlaces "Compartir fuera de la app" (la web abre /<idioma>/post/<id>).
EXPO_PUBLIC_WEB_URL=http://localhost:3000
