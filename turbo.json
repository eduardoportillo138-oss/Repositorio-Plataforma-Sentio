{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalDependencies": [".env"],
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "codegen": {
      "dependsOn": ["^codegen"],
      "inputs": ["codegen.ts", "schema.graphql", "operations/**/*.graphql"],
      "outputs": ["../api-client/src/generated/**"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "lint": {
      "dependsOn": []
    },
    "test": {
      "dependsOn": [],
      "outputs": ["coverage/**"],
      "env": ["MONGOMS_*"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
